#include <Arduino.h>

const int batteryPin = 34;

// Your divider values
const float R1 = 10000.0; // 10k
const float R2 = 3300.0;  // 3.3k
const float divisionRatio = R2 / (R1 + R2); 

void setup() {
  Serial.begin(115200);
  
  // 1. Force 12-bit resolution (0 - 4095)
  analogReadResolution(12); 
  
  // 2. IMPORTANT: Change attenuation to 11dB to cleanly fit the 1.04V pin input
  analogSetPinAttenuation(batteryPin, ADC_11db); 
}

void loop() {
  // 3. Multisample to eradicate ADC noise spikes
  uint32_t rawSum = 0;
  const int samples = 64;
  
  for (int i = 0; i < samples; i++) {
    rawSum += analogRead(batteryPin);
    delay(1);
  }
  float rawAverage = (float)rawSum / samples;

  // 4. Calculate voltage at the Pin 
  // (Using 3.6V max scale ceiling for 11dB attenuation mapping)
  float pinVoltage = (rawAverage * 3.6) / 4095.0; 

  // 5. Calculate final battery voltage using your divider math
  float batteryVoltage = pinVoltage / divisionRatio;

  // 6. Manual Calibration Factor
  // Measure your real battery using a voltmeter. If the serial output reads 4.0V 
  // but your multimeter says 4.15V, adjust this factor (e.g., 4.15 / 4.0 = 1.0375)
  float calibrationFactor = 1.00; 
  batteryVoltage *= calibrationFactor;

  Serial.print("Raw ADC: "); Serial.print(rawAverage, 0);
  Serial.print(" | Pin Volts: "); Serial.print(pinVoltage, 2);
  Serial.print("V | Battery Volts: "); Serial.print(batteryVoltage, 2);
  Serial.println("V");

  delay(1000);
}