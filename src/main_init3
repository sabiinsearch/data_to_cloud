#include <Arduino.h>
#define RXD2 16
#define TXD2 17

void setup() {
  // Start the USB serial monitor
  Serial.begin(115200);
  
  // Start Hardware Serial 2 for the GPS at 9600 baud
  Serial2.begin(9600, SERIAL_8N1, RXD2, TXD2);
  Serial.println("Testing NEO-6M GPS Module...");
}

void loop() {
  // Pass data from GPS to Serial Monitor
  while (Serial2.available()) {
    Serial.print((char)Serial2.read());
  }
}